# =============================================================================
# rehearsal / .ansible-lint
# =============================================================================
#
# Run locally the same way CI runs it:
#   cd rehearsal && ansible-lint --profile production playbook.yml
#
# `production` is ansible-lint's strictest profile. Starting there and
# justifying each exception in writing is more useful than starting at `basic`
# and never revisiting it — a skip list with reasons is reviewable; a lenient
# profile is invisible.
# =============================================================================

profile: production

exclude_paths:
  - inventory.ini          # generated by tuning, gitignored
  - kubeconfig.podium      # generated by orchestra, gitignored
  - collections/

skip_list:
  # ---------------------------------------------------------------------------
  # var-naming[no-role-prefix]
  #
  # The rule wants every variable in the `orchestra` role prefixed
  # `orchestra_` — so `k3s_version` would become `orchestra_k3s_version`.
  #
  # It exists to stop two roles colliding on a name, which is a real problem
  # when roles come from Galaxy and nobody coordinates. It doesn't apply here:
  # the `k3s_*` variables are not role-private state, they are PLATFORM
  # settings declared in group_vars/ensemble.yml and merely consumed by the
  # role. That is where someone tuning this cluster expects to find them, and
  # `k3s_version` says what it is in a way `orchestra_k3s_version` does not.
  #
  # The trade: if a second role ever wanted its own `k3s_version`, this would
  # bite. There is one role that touches K3s, and if that changes the rename is
  # mechanical.
  - var-naming[no-role-prefix]

# jinja[spacing] fires once, on the K3s argument template in orchestra. It
# suggests removing the space before `{%-` — but `{%-` strips preceding
# whitespace itself, so the rendered output is byte-identical either way, and
# the space is an artefact of the folded YAML scalar rather than something
# written. Left as a warning rather than skipped, because it is a fair
# observation about a construct worth noticing.
#
# The rendered result is verified directly: see the argument-composition tests
# in the layer's README.
