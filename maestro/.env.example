# =============================================================================
# maestro / .env.example
# =============================================================================
#
#   cp .env.example .env      # .env is gitignored
#
# maestro reads plain environment variables, so `.env` is sourced by your shell
# rather than parsed by the tool:
#
#   set -a; . ./.env; set +a
#   ./triage.py serve
#
# No dotenv library, because that would be maestro's only dependency and it
# would exist to save one line of shell.
# =============================================================================

# The shared secret Alertmanager presents. Must match OVERTURE-style token in
# backstage/secrets.enc.yaml — same value, two delivery mechanisms, because the
# two consumers live in different places: Alertmanager gets it as a Kubernetes
# Secret, maestro gets it as a local env var.
#
# Read yours out of the encrypted file with:
#   sops decrypt ../backstage/secrets.enc.yaml | grep MAESTRO_WEBHOOK_TOKEN
MAESTRO_TOKEN=replace-me

# Where to listen. 127.0.0.1 on purpose: the SSH reverse tunnel terminates on
# this machine's loopback, so nothing needs to be exposed on the local network.
MAESTRO_ADDR=127.0.0.1:9099

# Where the notes get appended, in addition to stdout.
MAESTRO_LOG=./notes.md

# --- Ollama ------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# llama3.2:3b is 2.0 GB and leaves comfortable room on 6 GB of VRAM for the
# context window, which matters because a crash-looping pod produces a lot of
# log lines.
#
# llama3.1:8b (4.9 GB) writes noticeably better notes and fits — barely. With a
# long excerpt the KV cache pushes past 6 GB and Ollama spills layers to CPU,
# at which point a 20-second inference becomes a two-minute one. Worth trying;
# watch `ollama ps` for the CPU/GPU split rather than guessing.
OLLAMA_MODEL=llama3.2:3b

# How long to wait for the model. Local inference on a small GPU is slow enough
# that the default socket timeout would give up first.
OLLAMA_TIMEOUT=180

# --- Optional: pull matching logs from Loki ----------------------------------
#
# Unset by default, and maestro works without it — the Alertmanager payload
# alone carries labels, annotations and the firing value.
#
# With it set, maestro queries Loki for the alert's namespace and writes a much
# better note, because it is reasoning about what the application actually said
# rather than about the shape of the alert.
#
# Loki has no ingress (layer 6), so this needs a port-forward:
#   kubectl -n metronome port-forward svc/loki 3100:3100
# LOKI_URL=http://localhost:3100
LOKI_LINES=200
